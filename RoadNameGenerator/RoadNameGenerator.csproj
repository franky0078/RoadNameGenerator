<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>

		<AssemblyName>RoadNameGenerator</AssemblyName>
		<RootNamespace>RoadNameGenerator</RootNamespace>

		<!--
        The file where mod information required for publishing
        the mod on PDX Mods is stored.
        -->
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
	</PropertyGroup>

	<PropertyGroup>
        <UIProjectDirectory>$(MSBuildProjectDirectory)\Frontend</UIProjectDirectory>
        <EnableRoadNameGeneratorUIBuild Condition="'$(EnableRoadNameGeneratorUIBuild)' == ''">true</EnableRoadNameGeneratorUIBuild>
        <DefaultItemExcludes>Frontend\node_modules\**;Frontend\build\**;$(DefaultItemExcludes)</DefaultItemExcludes>
        <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    </PropertyGroup>

    <!-- Imports must be after the PropertyGroup block -->
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />
	<ItemGroup>
		<Reference Include="Game">
			<Private>false</Private>
		</Reference>

		<Reference Include="Colossal.Core">
			<Private>false</Private>
		</Reference>

		<Reference Include="Colossal.Mathematics">
			<Private>false</Private>
		</Reference>

		<Reference Include="Colossal.Logging">
			<Private>false</Private>
		</Reference>

		<Reference Include="Colossal.IO.AssetDatabase">
			<Private>false</Private>
		</Reference>

		<Reference Include="Colossal.UI">
			<Private>false</Private>
		</Reference>

		<Reference Include="Colossal.UI.Binding">
			<Private>false</Private>
		</Reference>

		<Reference Include="Colossal.Localization">
			<Private>false</Private>
		</Reference>

		<Reference Include="Unity.InputSystem">
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine.CoreModule">
			<Private>false</Private>
		</Reference>

		<Reference Include="Unity.Burst">
			<Private>false</Private>
		</Reference>

		<Reference Include="Unity.Collections">
			<Private>false</Private>
		</Reference>

		<Reference Include="Unity.Entities">
			<Private>false</Private>
		</Reference>

		<Reference Include="Unity.Mathematics">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Update="System">
			<Private>false</Private>
		</Reference>

		<Reference Update="System.Core">
			<Private>false</Private>
		</Reference>

		<Reference Update="System.Data">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />

		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
	</ItemGroup>

    <Target Name="RestoreRoadNameGeneratorUI" Condition="'$(EnableRoadNameGeneratorUIBuild)' == 'true'" Inputs="$(UIProjectDirectory)\package.json;$(UIProjectDirectory)\package-lock.json" Outputs="$(UIProjectDirectory)\node_modules\.road-name-generator-restored">
        <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(UIProjectDirectory)" />
        <Touch Files="$(UIProjectDirectory)\node_modules\.road-name-generator-restored" AlwaysCreate="true" />
    </Target>
    <Target Name="BuildRoadNameGeneratorUI" AfterTargets="AfterBuild" DependsOnTargets="RestoreRoadNameGeneratorUI" Condition="'$(EnableRoadNameGeneratorUIBuild)' == 'true'">
        <Exec Command="npm run build" WorkingDirectory="$(UIProjectDirectory)" />
    </Target>
</Project>
